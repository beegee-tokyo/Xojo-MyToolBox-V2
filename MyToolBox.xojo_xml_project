   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Pressed()</SourceLine>
    <SourceLine>Var interval As Integer = Val(Tf_JoinInterval.Text)</SourceLine>
    <SourceLine>Var repeat As Integer = Val(Tf_JoinRepeat.Text)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If interval &lt; 7 Or interval &gt; 255 Then</SourceLine>
    <SourceLine>UI_Error_Message("MyToolBox", "Join Interval is invalid.", "Enter a value between 7 and 255 seconds.")</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If repeat &lt; 0 Or repeat &gt; 255 Then</SourceLine>
    <SourceLine>UI_Error_Message("MyToolBox", "Join Repeat is invalid.", "Enter a value between 0 and 255. 0 = unlimited.")</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>

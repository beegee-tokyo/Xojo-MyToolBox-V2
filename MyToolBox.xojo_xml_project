   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Function KeyDown(key As String) As Boolean</SourceLine>
    <SourceLine>If Key = Chr(13) Then // (&amp;h24) (&amp;h4c)</SourceLine>
    <SourceLine>If Not (Tf_Send.Text.isEmpty) Then</SourceLine>
    <SourceLine>// Check for buffer overflow</SourceLine>
    <SourceLine>If HistoryLength = 51 Then</SourceLine>
    <SourceLine>// Buffer full, shift the entries</SourceLine>
    <SourceLine>For i As Integer = 0 To 49</SourceLine>
    <SourceLine>HistoryBuffer(i) = HistoryBuffer(i+1)</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>HistoryBuffer(49) = ""</SourceLine>
    <SourceLine>HistoryLength = 50</SourceLine>
    <SourceLine>HistoryIndex = HistoryLength - 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>// Add to History</SourceLine>
    <SourceLine>HistoryBuffer(HistoryLength) = Tf_Send.Text</SourceLine>
    <SourceLine>HistoryLength = HistoryLength + 1</SourceLine>
    <SourceLine>HistoryIndex = HistoryLength - 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Var command As String = Tf_Send.Text</SourceLine>
    <SourceLine>'Var db_length As Integer = command.Length</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If command.Length &lt;&gt; 0 Then</SourceLine>
    <SourceLine>'Send data</SourceLine>
    <SourceLine>UI_LogBuffer.Append("&gt; " + command + Chr(13))</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>UART_Send(command + Chr(13))</SourceLine>
    <SourceLine>Tf_Send.Text = ""</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Return True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If Keyboard.AsyncKeyDown(&amp;h7E) Then // Key = Chr(126) Then // UP key</SourceLine>
    <SourceLine>If HistoryLength &gt; 0 Then</SourceLine>
    <SourceLine>Tf_Send.Text = HistoryBuffer(HistoryIndex)</SourceLine>
    <SourceLine>If HistoryIndex = 0 Then</SourceLine>
    <SourceLine>HistoryIndex = HistoryLength - 1</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>HistoryIndex = HistoryIndex - 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Return (Key = Chr(126))</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If Keyboard.AsyncKeyDown(&amp;h7D) Then // Key = Chr(125) Then // DOWN key</SourceLine>
    <SourceLine>If HistoryLength &gt; 0 Then</SourceLine>
    <SourceLine>Tf_Send.Text = HistoryBuffer(HistoryIndex)</SourceLine>
    <SourceLine>If HistoryIndex = HistoryLength - 1 Then</SourceLine>
    <SourceLine>HistoryIndex = 0</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>HistoryIndex = HistoryIndex + 1</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Return (Key = Chr(126))</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Return False</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Function</SourceLine>
   </ItemSource>
  </HookInstance>

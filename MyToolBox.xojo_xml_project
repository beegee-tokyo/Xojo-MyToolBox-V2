  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub UART_Connect()</SourceLine>
   <SourceLine>'Set the serial device to the index of the one chosen in the popup menu</SourceLine>
   <SourceLine>Var selected_device As Integer = P_PortList.SelectedRowIndex</SourceLine>
   <SourceLine>If Not(selected_device = -1) Then</SourceLine>
   <SourceLine>UART_User_Port_Selected = True</SourceLine>
   <SourceLine>S_UART.Device = SerialDevice.At(P_PortList.SelectedRowIndex)</SourceLine>
   <SourceLine>UART_Last_Connection_Port = P_PortList.CellTextAt(P_PortList.SelectedRowIndex)</SourceLine>
   <SourceLine>UART_RxBuffer = ""</SourceLine>
   <SourceLine>UART_RxPending = ""</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>S_UART.baud = 115200</SourceLine>
   <SourceLine>S_UART.bits = 8</SourceLine>
   <SourceLine>S_UART.parity = SerialConnection.Parities.None</SourceLine>
   <SourceLine>S_UART.StopBit = SerialConnection.StopBits.One</SourceLine>
   <SourceLine>'Set flow control options</SourceLine>
   <SourceLine>S_UART.CTS = False</SourceLine>
   <SourceLine>S_UART.DTR = False</SourceLine>
   <SourceLine>S_UART.XON = False</SourceLine>
   <SourceLine>'set flow control lines</SourceLine>
   <SourceLine>S_UART.RequestToSend = True</SourceLine>
   <SourceLine>S_UART.DataTerminalReady = True</SourceLine>
   <SourceLine>S_UART.Reset</SourceLine>
   <SourceLine>S_UART.Connect</SourceLine>
   <SourceLine>Catch error As IOException</SourceLine>
   <SourceLine>If UART_Reconnecting Then</SourceLine>
   <SourceLine>S_UART.Reset</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>UART_Last_Connection_Port = ""</SourceLine>
   <SourceLine>System.Beep</SourceLine>
   <SourceLine>UI_Error_Message("Signal Meter WARNING", "The selected serial device could not be opened.", "Check if the port is in use")</SourceLine>
   <SourceLine>B_Connect.Enabled = True</SourceLine>
   <SourceLine>UART_User_Port_Selected = False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Finally</SourceLine>
   <SourceLine>P_PortList.Enabled = False</SourceLine>
   <SourceLine>Ti_PortUpdater.RunMode = Timer.RunModes.Off</SourceLine>
   <SourceLine>Ti_PollRX.RunMode = Timer.RunModes.Multiple</SourceLine>
   <SourceLine>B_Connect.Caption = "Disconnect"</SourceLine>
   <SourceLine>UART_Connected = True</SourceLine>
   <SourceLine>L_PortName.Text = UART_Last_Connection_Port</SourceLine>
   <SourceLine>L_PortName.Visible = (UART_Last_Connection_Port &lt;&gt; "")</SourceLine>
   <SourceLine>if UART_Reconnecting Then</SourceLine>
   <SourceLine>'Start collecting device info with 2 seconds delay after a reconnect</SourceLine>
   <SourceLine>Timer.CallLater(2000, AddressOf UART_GetDeviceInfo)</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>UI_Busy_Control(False)</SourceLine>
   <SourceLine>Ti_UI_Enable.Mode = 1</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>UI_Error_Message("Signal Meter WARNING", "No serial device selected.", "Select a port first")</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End Sub</SourceLine>

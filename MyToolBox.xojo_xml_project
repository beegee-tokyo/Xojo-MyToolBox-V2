    <SourceLine>Function KeyDown(key As String) As Boolean</SourceLine>
    <SourceLine>If Key = Chr(13) Then // (&amp;h24) (&amp;h4c)</SourceLine>
    <SourceLine>If Not (Tf_SendInt.Text.isEmpty) Then</SourceLine>
    <SourceLine>Var command As String = "ATC+SendInt=" + Tf_SendInt.Text</SourceLine>

  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub UART_UpdateDevice()</SourceLine>
   <SourceLine>Var retry_send As Integer = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DEV_LoraMode = 1 Then 'LoRaWAN</SourceLine>
   <SourceLine>'Send data</SourceLine>
   <SourceLine>Var commands() As String = Array("AT+APPKEY=","AT+DEVEUI=","AT+APPEUI=","AT+APPSKEY=","AT+NWKSKEY=","AT+DEVADDR=")</SourceLine>
   <SourceLine>Var idx As Integer = 0</SourceLine>
   <SourceLine>Var end_idx As Integer = 5</SourceLine>
   <SourceLine>Var start_idx As Integer = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DEV_LW_JoinMode.Contains("0") Then</SourceLine>
   <SourceLine>start_idx = 3</SourceLine>
   <SourceLine>end_idx = 5</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>start_idx = 0 </SourceLine>
   <SourceLine>end_idx = 2</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>For idx = start_idx To end_idx</SourceLine>
   <SourceLine>Var unused As Boolean = App.Sem_Uart_Command_Finished.TrySignal</SourceLine>
   <SourceLine>unused = True</SourceLine>
   <SourceLine>UART_AT_TYPE = 1</SourceLine>
   <SourceLine>UART_Wait_For = commands(idx)</SourceLine>
   <SourceLine>Select Case idx</SourceLine>
   <SourceLine>Case 0</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_LW_AppKey</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Case 1</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_LW_DevEUI</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Case 2</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_LW_AppEUI</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Case 3</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_LW_AppSKey</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Case 4</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_LW_NwSKey</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Case 5</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_LW_DevAddr</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>App.Sem_Uart_Command_Finished.Signal</SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=0</SourceLine>
   <SourceLine>If (UART_Command_Ok) Then</SourceLine>
   <SourceLine>retry_send = 3</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If Not UART_Connected Then</SourceLine>
   <SourceLine>UART_AT_TYPE = 0</SourceLine>
   <SourceLine>Return</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
   <SourceLine>Catch</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>ElseIf DEV_LoraMode = 2 Then 'FSK</SourceLine>
   <SourceLine>'Send data</SourceLine>
   <SourceLine>Var commands() As String = Array("AT+PFREQ=","AT+PBR=","AT+PFDEV=","AT+PBW=","AT+PPL=","AT+PTP=","AT+SYNCWORD=")</SourceLine>
   <SourceLine>Var idx As Integer</SourceLine>
   <SourceLine>for idx = 0 to 6</SourceLine>
   <SourceLine>App.Sem_Uart_Command_Finished.Signal</SourceLine>
   <SourceLine>UART_AT_TYPE = 1</SourceLine>
   <SourceLine>UART_Wait_For = commands(idx)</SourceLine>
   <SourceLine>Select Case idx</SourceLine>
   <SourceLine>Case 0</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_P2P_Freq</SourceLine>
   <SourceLine>Case 1</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_FSK_BR</SourceLine>
   <SourceLine>Case 2</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_FSK_FDEV</SourceLine>
   <SourceLine>Case 3</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_FSK_BW</SourceLine>
   <SourceLine>Case 4</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_P2P_PreambleLen</SourceLine>
   <SourceLine>Case 5</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_P2P_TX</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_FSK_SyncWord</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
   <SourceLine>App.Sem_Uart_Command_Finished.Signal</SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=0</SourceLine>
   <SourceLine>If (UART_Command_Ok) Then</SourceLine>
   <SourceLine>retry_send = 3</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If Not UART_Connected Then</SourceLine>
   <SourceLine>UART_AT_TYPE = 0</SourceLine>
   <SourceLine>Return</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
   <SourceLine>Catch</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>Else 'LoRa P2P</SourceLine>
   <SourceLine>'Send data</SourceLine>
   <SourceLine>Var commands() As String = Array("AT+PBW=","AT+PCR=","AT+PFREQ=","AT+PPL=","AT+PSF=","AT+PTP=")</SourceLine>
   <SourceLine>Var idx As Integer</SourceLine>
   <SourceLine>for idx = 0 to 5</SourceLine>
   <SourceLine>App.Sem_Uart_Command_Finished.Signal</SourceLine>
   <SourceLine>UART_AT_TYPE = 1</SourceLine>
   <SourceLine>UART_Wait_For = commands(idx)</SourceLine>
   <SourceLine>Select Case idx</SourceLine>
   <SourceLine>Case 0</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_P2P_BW</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Case 1</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_P2P_CR</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Case 2</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_P2P_Freq</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Case 3</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_P2P_PreambleLen</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + DEV_P2P_SF</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
   <SourceLine>App.Sem_Uart_Command_Finished.Signal</SourceLine>
   <SourceLine>Ti_Rx_Timeout.Mode=0</SourceLine>
   <SourceLine>If (UART_Command_Ok) Then</SourceLine>
   <SourceLine>retry_send = 3</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>If Not UART_Connected Then</SourceLine>
   <SourceLine>UART_AT_TYPE = 0</SourceLine>
   <SourceLine>Return</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
   <SourceLine>Catch</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UART_AT_TYPE = 0</SourceLine>
   <SourceLine>End Sub</SourceLine>

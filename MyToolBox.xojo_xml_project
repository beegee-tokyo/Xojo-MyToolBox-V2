  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Opening()</SourceLine>
   <SourceLine>'Set window name with app version</SourceLine>
   <SourceLine>App_Window.Title = "MyToolBox V" + Str(App.MajorVersion) + "." + Str( App.MinorVersion ) + "." + Str( App.BugVersion )</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Initialize Semaphores</SourceLine>
   <SourceLine>App.Sem_Uart_Command_Finished = New Semaphore(1)</SourceLine>
   <SourceLine>App.Sem_Uart_Request_Finished = New Semaphore(1)</SourceLine>
   <SourceLine>App.Sem_Log_Finished = New Semaphore(1)</SourceLine>
   <SourceLine>App.Sem_Tx_Finished = New Semaphore(1)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Initialize Serial Buffer</SourceLine>
   <SourceLine>UI_LogBuffer = New CircularStringBuffer(10000)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Show Busy Wheel while looking for COM ports</SourceLine>
   <SourceLine>Timer.CallLater(50, AddressOf UI_Busy_Control, True)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Disable UI</SourceLine>
   <SourceLine>UI_Enable_Disable(False)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Set default values</SourceLine>
   <SourceLine>UART_AT_Command = ""</SourceLine>
   <SourceLine>UART_AT_TYPE = 0</SourceLine>
   <SourceLine>UART_Command_Error = False</SourceLine>
   <SourceLine>UART_Command_Ok = False</SourceLine>
   <SourceLine>UART_Connected = False</SourceLine>
   <SourceLine>UART_Request_Ok = False</SourceLine>
   <SourceLine>UART_Response = ""</SourceLine>
   <SourceLine>UART_ResponseValue = ""</SourceLine>
   <SourceLine>UART_TxBuffer = ""</SourceLine>
   <SourceLine>UART_TX_Bytes_Left = 0</SourceLine>
   <SourceLine>UART_User_Port_Selected = False</SourceLine>
   <SourceLine>UART_Wait_For = ""</SourceLine>
   <SourceLine>UART_Wait_For_Answer = False</SourceLine>
   <SourceLine>UART_Wait_For_Command = False</SourceLine>
   <SourceLine>UI_UpdateRequired = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'LoRaWAN is the default tab</SourceLine>
   <SourceLine>UI_Settings.SelectedPanelIndex = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If TargetLinux Or TargetMacOS Then</SourceLine>
   <SourceLine>P_PortList.FontSize = 8</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End Sub</SourceLine>

    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Run()</SourceLine>
    <SourceLine>Me.Cancel = False</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Dim N As Integer = Me.Data.Size</SourceLine>
    <SourceLine>UART_TX_Bytes_Left = N</SourceLine>
    <SourceLine>Dim psize As Integer = 256 'packet size</SourceLine>
    <SourceLine>Dim packets As Integer = Ceil(N / psize)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'-------------------------</SourceLine>
    <SourceLine>'Send Data</SourceLine>
    <SourceLine>'-------------------------</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Send data in chunks of size psize</SourceLine>
    <SourceLine>Dim txt As String = If(Me.Data.Size &lt;= 0, "", Me.data.StringValue(0, Me.Data.Size))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>For i As Integer = 0 To packets-1</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If Me.cancel Then </SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Tx_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>Exit</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>S_UART.Poll</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'extract a chunk</SourceLine>
    <SourceLine>Dim chunk As MemoryBlock = MidB(txt, i * psize + 1, psize)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'send the chunk in one piece</SourceLine>
    <SourceLine>If Me.cancel Then Exit</SourceLine>
    <SourceLine>Dim chunkStr As String = If(chunk.Size &lt;= 0, "", chunk.StringValue(0, chunk.Size))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If Not UART_Transmit(chunkStr) Then </SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Tx_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>Exit</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>UART_TX_Bytes_Left = Max(0, N -(i + 1) * psize)</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'remove any leftover data from UART_TxBuffer</SourceLine>
    <SourceLine>UART_TxBuffer = ""</SourceLine>
    <SourceLine>UART_TX_Bytes_Left = 0</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Tx_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>

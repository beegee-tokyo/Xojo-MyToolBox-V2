   <ItemName>LineStateChanged</ItemName>
   <Compatibility></Compatibility>
   <Visible>1</Visible>
   <PartID>1596485631</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub LineStateChanged(changedLines() As SerialConnection.LineStates)</SourceLine>
    <SourceLine>Var changes As String = ""</SourceLine>
    <SourceLine>Var idx as Integer</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>for idx = 0 to changedLines.LastIndex</SourceLine>
    <SourceLine>if changedLines(idx) = SerialConnection.LineStates.ClearToSend Then</SourceLine>
    <SourceLine>changes = changes + "CTS "</SourceLine>
    <SourceLine>if SerialConnection.LineStates.ClearToSend = 1 Then</SourceLine>
    <SourceLine>changes = changes + "1 - "</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>changes = changes + "0 - "</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>UART_LineChange = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>if changedLines(idx) = SerialConnection.LineStates.DataCarrierDetect Then</SourceLine>
    <SourceLine>changes = changes + "DCD - "</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>if changedLines(idx) = SerialConnection.LineStates.DataSetReady Then</SourceLine>
    <SourceLine>changes = changes + "DSR - "</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>if changedLines(idx) = SerialConnection.LineStates.DataTerminalReady Then</SourceLine>
    <SourceLine>changes = changes + "DTR - "</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>if changedLines(idx) = SerialConnection.LineStates.RequestToSend Then</SourceLine>
    <SourceLine>changes = changes + "RTS "</SourceLine>
    <SourceLine>if SerialConnection.LineStates.RequestToSend = 1 Then</SourceLine>
    <SourceLine>changes = changes + "1 - "</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>changes = changes + "0 - "</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>UART_LineChange = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>if changedLines(idx) = SerialConnection.LineStates.RingIndicator Then</SourceLine>
    <SourceLine>changes = changes + "RI - "</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>

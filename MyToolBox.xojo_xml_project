 <Method>
  <ItemName>UI_Mask_Setup</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1559011839</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub UI_Mask_Setup()</SourceLine>
   <SourceLine>'Fill the channel mask list for the active region and select the active mask.</SourceLine>
   <SourceLine>'The channel mask only exists for CN470, US915 and AU915. For all other regions the entry is hidden.</SourceLine>
   <SourceLine>Var was_active As Boolean = UI_UpdateActive</SourceLine>
   <SourceLine>UI_UpdateActive = True</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var band As Integer = Val(DEV_LW_Region)</SourceLine>
   <SourceLine>Var sub_bands As Integer = UI_Mask_SubBands</SourceLine>
   <SourceLine>Var idx As Integer</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>P_Mask.RemoveAllRows</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If sub_bands = 0 Or DEV_MaskUnsupported Then</SourceLine>
   <SourceLine>L_Mask.Visible = False</SourceLine>
   <SourceLine>P_Mask.Visible = False</SourceLine>
   <SourceLine>UI_UpdateActive = was_active</SourceLine>
   <SourceLine>Return</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>P_Mask.AddRow("All channels")</SourceLine>
   <SourceLine>For idx = 1 To sub_bands</SourceLine>
   <SourceLine>Var first_ch As Integer = (idx - 1) * 8</SourceLine>
   <SourceLine>Var ch_text As String = "ch " + Str(first_ch) + "-" + Str(first_ch + 7)</SourceLine>
   <SourceLine>If band &lt;&gt; 1 Then ch_text = ch_text + ", " + Str(63 + idx) 'US915 and AU915 have one extra 500 kHz channel per sub-band</SourceLine>
   <SourceLine>P_Mask.AddRow("Sub-band " + Str(idx) + " (" + ch_text + ")")</SourceLine>
   <SourceLine>Next</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var mask_val As Integer = 0</SourceLine>
   <SourceLine>If DEV_LW_Mask &lt;&gt; "" Then mask_val = Val("&amp;h" + DEV_LW_Mask)</SourceLine>
   <SourceLine>Var sel As Integer = 0</SourceLine>
   <SourceLine>Var all_mask As Integer = Bitwise.ShiftLeft(1, sub_bands) - 1</SourceLine>
   <SourceLine>If mask_val = 0 Or mask_val = all_mask Or mask_val = &amp;h01FF Or mask_val = &amp;h0FFF Then</SourceLine>
   <SourceLine>'0000 and the default masks mean all channels</SourceLine>
   <SourceLine>sel = 0</SourceLine>
   <SourceLine>ElseIf mask_val &lt; Bitwise.ShiftLeft(1, sub_bands) And Bitwise.BitAnd(mask_val, mask_val - 1) = 0 Then</SourceLine>
   <SourceLine>'Exactly one sub-band</SourceLine>
   <SourceLine>Var bit_no As Integer = 0</SourceLine>
   <SourceLine>While Bitwise.ShiftRight(mask_val, bit_no + 1) &gt; 0</SourceLine>
   <SourceLine>bit_no = bit_no + 1</SourceLine>
   <SourceLine>Wend</SourceLine>
   <SourceLine>sel = bit_no + 1</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>'A combination of sub-bands. It is shown as an extra entry which is never sent to the device</SourceLine>
   <SourceLine>P_Mask.AddRow("Custom (" + DEV_LW_Mask + ")")</SourceLine>
   <SourceLine>sel = P_Mask.RowCount - 1</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>P_Mask.SelectedRowIndex = sel</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>L_Mask.Visible = True</SourceLine>
   <SourceLine>P_Mask.Visible = True</SourceLine>
   <SourceLine>P_Mask.Enabled = True</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UI_UpdateActive = was_active</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams></ItemParams>
  <ItemResult></ItemResult>
 </Method>

 <Method>
  <ItemName>UART_WakeDevice</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>281377791</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub UART_WakeDevice()</SourceLine>
   <SourceLine>'The RAK11720 reports SLEEP when it goes into power saving and then ignores AT commands.</SourceLine>
   <SourceLine>'A dummy command wakes it up, it answers with WAKE_UP and accepts AT commands until it reports SLEEP again.</SourceLine>
   <SourceLine>'Other modules just answer the dummy command AT with OK.</SourceLine>
   <SourceLine>If UART_WakeInProgress Then Return</SourceLine>
   <SourceLine>If Not UART_Connected Then Return</SourceLine>
   <SourceLine>UART_WakeInProgress = True</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'The answer of the dummy command must not be taken as the answer of a real command</SourceLine>
   <SourceLine>Var saved_type As Integer = UART_AT_TYPE</SourceLine>
   <SourceLine>UART_AT_TYPE = 0</SourceLine>
   <SourceLine>UART_WakeSeen = False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; AT" + Chr(13))</SourceLine>
   <SourceLine>UART_Send("AT" + Chr(13))</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Wait for WAKE_UP (or OK if the module was awake), 1.5 seconds at most</SourceLine>
   <SourceLine>Var start_us As Double = System.Microseconds</SourceLine>
   <SourceLine>While Not UART_WakeSeen And (System.Microseconds - start_us) &lt; 1500000</SourceLine>
   <SourceLine>If Thread.Current Is Nil Then</SourceLine>
   <SourceLine>App.DoEvents(10)</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>Thread.SleepCurrent(10)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Wend</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Give the module a moment and let a trailing OK arrive before the real command is sent</SourceLine>
   <SourceLine>start_us = System.Microseconds</SourceLine>
   <SourceLine>While (System.Microseconds - start_us) &lt; 200000</SourceLine>
   <SourceLine>If Thread.Current Is Nil Then</SourceLine>
   <SourceLine>App.DoEvents(10)</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>Thread.SleepCurrent(10)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Wend</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UART_DevAsleep = False</SourceLine>
   <SourceLine>UART_AT_TYPE = saved_type</SourceLine>
   <SourceLine>UART_WakeInProgress = False</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>

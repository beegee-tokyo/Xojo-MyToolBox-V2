 <Method>
  <ItemName>Append</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1430589439</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Append(StrData as string)</SourceLine>
   <SourceLine>If StrData = "" Then Return</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>mLock.Signal</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Load the data into temporary buffer</SourceLine>
   <SourceLine>Dim TempBuffer As MemoryBlock = StrData</SourceLine>
   <SourceLine>Dim TempLength As Integer = TempBuffer.Size</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Append the contents of the temporary buffer into the circular buffer</SourceLine>
   <SourceLine>Dim mSize As Integer = Size</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Special Case: data length exceeds buffersize</SourceLine>
   <SourceLine>If mSize &lt; TempLength Then</SourceLine>
   <SourceLine>'There is more data than room in the circular buffer</SourceLine>
   <SourceLine>'Only store the last data</SourceLine>
   <SourceLine>Me.StringValue(0, mSize) = TempBuffer.StringValue(Templength - mSize, mSize)</SourceLine>
   <SourceLine>mDataLength = mSize</SourceLine>
   <SourceLine>mDataOffset = 0</SourceLine>
   <SourceLine>mLock.Release</SourceLine>
   <SourceLine>Return</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Data fits</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>// Set the offset where the new data will begin</SourceLine>
   <SourceLine>Dim oldWriteOffset As Integer = WriteOffset</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Case 1: data fits into the remaining space</SourceLine>
   <SourceLine>If mDataLength + TempLength &lt;= mSize Then</SourceLine>
   <SourceLine>'No data is required to be discarded</SourceLine>
   <SourceLine>'no change to mDataLength and mDataOffset</SourceLine>
   <SourceLine>Else 'Case 2: Data does not fit into remaining space</SourceLine>
   <SourceLine>'Some old data needs to be discarded</SourceLine>
   <SourceLine>Dim RemoveDataLength As Integer = (mDataLength + TempLength) - mSize</SourceLine>
   <SourceLine>mDataLength = mDataLength - RemoveDataLength</SourceLine>
   <SourceLine>mDataOffset = (mDataOffset + RemoveDataLength) Mod mSize</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Write data into buffer</SourceLine>
   <SourceLine>If DebugBuild Then</SourceLine>
   <SourceLine>If oldWriteOffset &lt;&gt; WriteOffset Then</SourceLine>
   <SourceLine>Break</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If WriteOffset + TempLength &lt;= mSize Then</SourceLine>
   <SourceLine>'Data does not need to wrap around</SourceLine>
   <SourceLine>Me.StringValue(WriteOffset, TempLength) = TempBuffer.StringValue(0, TempLength)</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>'Data needs to wrap around</SourceLine>
   <SourceLine>Dim length1 As Integer = mSize - WriteOffset</SourceLine>
   <SourceLine>Dim length2 As Integer = TempLength - length1</SourceLine>
   <SourceLine>Me.StringValue(WriteOffset, length1) = TempBuffer.StringValue(0, length1)</SourceLine>
   <SourceLine>Me.StringValue(0, length2) = TempBuffer.StringValue(length1, length2)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Set new mDataLength</SourceLine>
   <SourceLine>mDataLength = mDataLength + TempLength</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>mLock.Release</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Return</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>

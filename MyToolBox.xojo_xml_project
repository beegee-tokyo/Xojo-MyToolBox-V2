   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Function KeyDown(key As String) As Boolean</SourceLine>
    <SourceLine>If Key = Chr(13) Then // (&amp;h24) (&amp;h4c)</SourceLine>
    <SourceLine>If Not (Tf_PreambleLen.Text.isEmpty) Then</SourceLine>
    <SourceLine>Var command As String = "AT+PPL=" + Tf_PreambleLen.Text</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Send data</SourceLine>
    <SourceLine>UI_LogBuffer.Append("&gt; " + command + Chr(13))</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>UART_Send(command + Chr(13))</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>Return False</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Return False</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Function</SourceLine>
   </ItemSource>
  </HookInstance>

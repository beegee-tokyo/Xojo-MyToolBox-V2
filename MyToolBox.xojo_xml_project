    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub SelectionChanged(item As DesktopMenuItem)</SourceLine>
    <SourceLine>If Not UI_UpdateActive Then</SourceLine>
    <SourceLine>'Row 0 is All channels, rows 1 to n are the sub-bands. A row behind that is the Custom entry, which is only a display of the current mask</SourceLine>
    <SourceLine>Var mask_row As Integer = P_Mask.SelectedRowIndex</SourceLine>
    <SourceLine>Var mask_max As Integer = UI_Mask_SubBands()</SourceLine>
    <SourceLine>If mask_row &lt; 0 Or mask_row &gt; mask_max Then</SourceLine>

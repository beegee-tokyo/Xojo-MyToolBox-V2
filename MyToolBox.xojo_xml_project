 <ControlBehavior>
  <Superclass>Timer</Superclass>
  <HookInstance>
   <ItemName>Action</ItemName>
   <Compatibility></Compatibility>
   <Visible>1</Visible>
   <PartID>224196607</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Action()</SourceLine>
    <SourceLine>' Check if ENTER key was pressed</SourceLine>
    <SourceLine>If UI_Send_Active Then</SourceLine>
    <SourceLine>If Keyboard.AsyncKeyDown(&amp;h4c) Then</SourceLine>
    <SourceLine>Timer.CallLater(100, AddressOf UI_Send)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If Not RXDataAvailable Then Return</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>RXDataAvailable = False</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>Var data As String</SourceLine>
    <SourceLine>Var lines() As String</SourceLine>
    <SourceLine>Var idx As Integer</SourceLine>
    <SourceLine>Var rx_line As String</SourceLine>
    <SourceLine>Var rx_pos As Integer</SourceLine>
    <SourceLine>Var response As String</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Read everything that was received so far</SourceLine>
    <SourceLine>data = S_UART.ReadAll(Encodings.ASCII)</SourceLine>
    <SourceLine>If data = "" Then Return</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Display data</SourceLine>
    <SourceLine>UI_LogBuffer.Append(data)</SourceLine>
    <SourceLine>UI_Log_Display(UI_LogBuffer.Data)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'RAK11720 reports SLEEP when it goes into power saving and WAKE_UP after it was woken up</SourceLine>
    <SourceLine>If data.Contains("WAKE_UP") Then</SourceLine>
    <SourceLine>UART_DevAsleep = False</SourceLine>
    <SourceLine>UART_WakeSeen = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If data.Contains("SLEEP") Then</SourceLine>
    <SourceLine>If data.IndexOf("SLEEP") &gt; data.IndexOf("WAKE_UP") Then UART_DevAsleep = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If UART_WakeInProgress And data.Contains("OK") Then UART_WakeSeen = True</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'A line can arrive in several pieces (UART packets). Only complete lines are processed,</SourceLine>
    <SourceLine>'an incomplete last line stays in UART_RxBuffer until the rest of it has been received.</SourceLine>
    <SourceLine>UART_RxBuffer = UART_RxBuffer + data</SourceLine>
    <SourceLine>lines = UART_RxBuffer.Split(Chr(10))</SourceLine>
    <SourceLine>UART_RxBuffer = lines(lines.LastIndex)</SourceLine>
    <SourceLine>lines.RemoveAt(lines.LastIndex)</SourceLine>
    <SourceLine>If UART_RxBuffer.Length &gt; 2048 Then UART_RxBuffer = "" 'no line end for a long time, throw it away</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Process received data for command response</SourceLine>
    <SourceLine>If UART_AT_TYPE = 1 Then 'Waiting for command response</SourceLine>
    <SourceLine>If UART_Timeout_Error Then</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine>UART_Command_Ok = False</SourceLine>
    <SourceLine>UART_Command_Error = True</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>For idx = 0 To lines.LastIndex</SourceLine>
    <SourceLine>rx_line = lines(idx).ReplaceAll(Chr(13), "").Trim</SourceLine>
    <SourceLine>If rx_line = "" Then Continue For</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Ignore the echo of the command</SourceLine>
    <SourceLine>If UART_AT_Command &lt;&gt; "" And rx_line.BeginsWith(UART_AT_Command) Then Continue For</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Ignore debug output and events of the device (they can come at any time)</SourceLine>
    <SourceLine>If rx_line.Contains("SLEEP") Or rx_line.Contains("WAKE_UP") Then Continue For</SourceLine>
    <SourceLine>If rx_line.BeginsWith("+EVT:") Or rx_line.BeginsWith("[") Then Continue For</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>response = UI_StripNonPrintable(rx_line)</SourceLine>
    <SourceLine>If response.IndexOf("OK") &gt; -1 Then</SourceLine>
    <SourceLine>UART_Command_Ok = True</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>UART_RxBuffer = ""</SourceLine>
    <SourceLine>Exit For</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If response.IndexOf("AT_") &gt; -1 Then</SourceLine>
    <SourceLine>UART_Command_Ok = False</SourceLine>
    <SourceLine>UART_Command_Error = True</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>UART_RxBuffer = ""</SourceLine>
    <SourceLine>Exit For</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Process received data for request response</SourceLine>
    <SourceLine>If UART_AT_TYPE = 2 Then 'Waiting for request response</SourceLine>
    <SourceLine>If UART_Timeout_Error Then</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine>UART_Command_Ok = False</SourceLine>
    <SourceLine>UART_Command_Error = True</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>For idx = 0 To lines.LastIndex</SourceLine>
    <SourceLine>rx_line = lines(idx).ReplaceAll(Chr(13), "").Trim</SourceLine>
    <SourceLine>If rx_line = "" Then Continue For</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Ignore the echo of the request</SourceLine>
    <SourceLine>If UART_AT_Command &lt;&gt; "" And rx_line.Contains(UART_AT_Command) Then Continue For</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Ignore debug output and events of the device (they can come at any time)</SourceLine>
    <SourceLine>If rx_line.Contains("SLEEP") Or rx_line.Contains("WAKE_UP") Then Continue For</SourceLine>
    <SourceLine>If rx_line.BeginsWith("+EVT:") Or rx_line.BeginsWith("[") Then</SourceLine>
    <SourceLine>'...unless the response is in the same line</SourceLine>
    <SourceLine>If UART_Wait_For = "" Or rx_line.IndexOf(UART_Wait_For) = -1 Then Continue For</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>response = ""</SourceLine>
    <SourceLine>If UART_Wait_For &lt;&gt; "" And rx_line.IndexOf(UART_Wait_For) &gt; -1 Then</SourceLine>
    <SourceLine>'Remove everything in front of the response</SourceLine>
    <SourceLine>response = rx_line.Middle(rx_line.IndexOf(UART_Wait_For))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Remove debug output that was written into the response line</SourceLine>
    <SourceLine>rx_pos = response.IndexOf("+EVT:")</SourceLine>
    <SourceLine>If rx_pos &gt; 0 Then response = response.Left(rx_pos)</SourceLine>
    <SourceLine>rx_pos = response.IndexOf("[")</SourceLine>
    <SourceLine>If rx_pos &gt; 0 Then response = response.Left(rx_pos)</SourceLine>
    <SourceLine>response = response.Trim</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If response.Length &lt;= UART_Wait_For.Length Then</SourceLine>
    <SourceLine>'The value is missing. Debug output was written into the response, the value might follow in the next line</SourceLine>
    <SourceLine>UART_RxPending = response</SourceLine>
    <SourceLine>response = ""</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>ElseIf rx_line.IndexOf("AT_") &gt; -1 Then</SourceLine>
    <SourceLine>UART_Command_Ok = False</SourceLine>
    <SourceLine>UART_Command_Error = True</SourceLine>
    <SourceLine>UART_ResponseValue = rx_line</SourceLine>
    <SourceLine>UART_RxPending = ""</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>UART_RxBuffer = ""</SourceLine>
    <SourceLine>Exit For</SourceLine>
    <SourceLine>ElseIf UART_RxPending &lt;&gt; "" Then</SourceLine>
    <SourceLine>If rx_line.IndexOf("OK") &gt; -1 Then</SourceLine>
    <SourceLine>'Nothing follows, use the response as it is</SourceLine>
    <SourceLine>response = UART_RxPending</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>'Rest of the response</SourceLine>
    <SourceLine>response = UART_RxPending + rx_line</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If response &lt;&gt; "" Then</SourceLine>
    <SourceLine>UART_Command_Ok = True</SourceLine>
    <SourceLine>UART_ResponseValue = response</SourceLine>
    <SourceLine>UART_RxPending = ""</SourceLine>
    <SourceLine>If Not App.Sem_Uart_Request_Finished.TrySignal Then</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>UART_RxBuffer = ""</SourceLine>
    <SourceLine>Exit For</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If UART_Timeout_Error Then</SourceLine>
    <SourceLine>Var Has_Lock As Boolean = App.Sem_Uart_Command_Finished.TrySignal</SourceLine>
    <SourceLine>If Not Has_Lock Then</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Has_Lock = App.Sem_Uart_Command_Finished.TrySignal</SourceLine>
    <SourceLine>If Not Has_Lock Then</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>UART_Command_Ok = False</SourceLine>
    <SourceLine>UART_Command_Error = True</SourceLine>
    <SourceLine>UART_RxBuffer = ""</SourceLine>
    <SourceLine>UART_RxPending = ""</SourceLine>
    <SourceLine>'Flush RX buffer</SourceLine>
    <SourceLine>data = S_UART.ReadAll(Encodings.ASCII)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End Sub</SourceLine>

 <Method>
  <ItemName>UI_Update</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1028857855</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub UI_Update()</SourceLine>
   <SourceLine>Dim val_d As String </SourceLine>
   <SourceLine>Dim val As Integer</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UI_UpdateActive = True</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>L_Ver.Text = DEV_RUI3Ver</SourceLine>
   <SourceLine>L_AppVer.Text = DEV_AppVer</SourceLine>
   <SourceLine>L_HWModel.Text = DEV_HWModel</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If DEV_HasSendInt Then</SourceLine>
   <SourceLine>Tf_SendInt.Text = UI_StripNonPrintable(DEV_SendInterval_String)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If (DEV_LoRaMode = 2) Then</SourceLine>
   <SourceLine>'FSK</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>B_SendToDevice.Enabled = False</SourceLine>
   <SourceLine>B_SendToDevice.Visible = False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>P_NWM.SelectedRowIndex = 2</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UI_Settings.SelectedPanelIndex = 2</SourceLine>
   <SourceLine>UI_Settings.Refresh(True)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Set FSK values (frequency, preamble length and TX power are shared with LoRa P2P)</SourceLine>
   <SourceLine>Tf_FskFreq.Text = UI_StripNonPrintable(DEV_P2P_Freq)</SourceLine>
   <SourceLine>Tf_FskBR.Text = UI_StripNonPrintable(DEV_FSK_BR)</SourceLine>
   <SourceLine>Tf_FskFdev.Text = UI_StripNonPrintable(DEV_FSK_FDEV)</SourceLine>
   <SourceLine>Tf_FskBW.Text = UI_StripNonPrintable(DEV_FSK_BW)</SourceLine>
   <SourceLine>Tf_FskPre.Text = UI_StripNonPrintable(DEV_P2P_PreambleLen)</SourceLine>
   <SourceLine>Tf_FskSync.Text = UI_StripNonPrintable(DEV_FSK_SyncWord)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>val_d = DEV_P2P_TX</SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>P_FskTX.SelectedRowIndex = val - 5</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>ElseIf (DEV_LoRaMode = 0) Then</SourceLine>
   <SourceLine>'LoRa P2P</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>B_SendToDevice.Enabled = False</SourceLine>
   <SourceLine>B_SendToDevice.Visible = False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>P_NWM.SelectedRowIndex = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UI_Settings.SelectedPanelIndex = 1</SourceLine>
   <SourceLine>UI_Settings.Refresh(True)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Set P2P values</SourceLine>
   <SourceLine>Tf_Freq.Text = DEV_P2P_Freq</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>val_d = DEV_P2P_BW</SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>P_BW.SelectedRowIndex = val</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>val_d = DEV_P2P_CR</SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>P_CR.SelectedRowIndex = val</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>val_d = DEV_P2P_SF</SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>P_SF.SelectedRowIndex = val - 5</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Tf_PreambleLen.Text = UI_StripNonPrintable(DEV_P2P_PreambleLen)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>val_d = DEV_P2P_TX</SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>P_P2P_TX.SelectedRowIndex = val - 5</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>'LoRaWAN</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>B_SendToDevice.Enabled = True</SourceLine>
   <SourceLine>B_SendToDevice.Visible = True</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>P_NWM.SelectedRowIndex = 1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UI_Settings.SelectedPanelIndex = 0</SourceLine>
   <SourceLine>UI_Settings.Refresh(True)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>' Set Auto Join Status</SourceLine>
   <SourceLine>If (DEV_LW_AutoJoin) Then</SourceLine>
   <SourceLine>P_AutoJoin.SelectedRowIndex = 0</SourceLine>
   <SourceLine>P_AutoJoin.Refresh(True)</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>P_AutoJoin.SelectedRowIndex = 1</SourceLine>
   <SourceLine>P_AutoJoin.Refresh(True)</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Set join retry values</SourceLine>
   <SourceLine>Tf_JoinRepeat.Text = DEV_LW_JoinRepeat</SourceLine>
   <SourceLine>Tf_JoinInterval.Text = DEV_LW_JoinInterval</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Select region from ComboBox</SourceLine>
   <SourceLine>val_d = DEV_LW_Region </SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>If val &gt;= 0 And val &lt;= 13 Then</SourceLine>
   <SourceLine>P_Region.SelectedRowIndex = val 'the list order is the band number: EU433 = 0 ... LA915 = 12, ISM2400 = 13</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>P_Region.SelectedRowIndex = -1 'unknown band</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Set Credentials</SourceLine>
   <SourceLine>Tf_DevEUI.Text = UI_StripNonPrintable(DEV_LW_DevEUI)</SourceLine>
   <SourceLine>Tf_AppEUI.Text = UI_StripNonPrintable(DEV_LW_AppEUI)</SourceLine>
   <SourceLine>Tf_AppKey.Text = UI_StripNonPrintable(DEV_LW_AppKey)</SourceLine>
   <SourceLine>Tf_AppSKey.Text = UI_StripNonPrintable(DEV_LW_AppSKey)</SourceLine>
   <SourceLine>Tf_NwSKey.Text = UI_StripNonPrintable(DEV_LW_NwSKey)</SourceLine>
   <SourceLine>Tf_DevAddr.Text = UI_StripNonPrintable(DEV_LW_DevAddr)</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>val_d = DEV_LW_JoinMode </SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>P_JoinMode.SelectedRowIndex = val</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>val_d = DEV_LW_DR </SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>P_DR.SelectedRowIndex = val</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>val_d = DEV_LW_ADR </SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>P_ADR.SelectedRowIndex = val</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>val_d = DEV_LW_TX </SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>P_LW_TX.SelectedRowIndex = val</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>val_d = DEV_LW_CFM </SourceLine>
   <SourceLine>val = Val(val_d)</SourceLine>
   <SourceLine>P_CFM.SelectedRowIndex = val</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Select the LoRaWAN class (not every firmware supports it)</SourceLine>
   <SourceLine>If DEV_ClassUnsupported Then</SourceLine>
   <SourceLine>L_Class.Visible = False</SourceLine>
   <SourceLine>P_Class.Visible = False</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>L_Class.Visible = True</SourceLine>
   <SourceLine>P_Class.Visible = True</SourceLine>
   <SourceLine>Select Case DEV_LW_Class</SourceLine>
   <SourceLine>Case "A"</SourceLine>
   <SourceLine>P_Class.SelectedRowIndex = 0</SourceLine>
   <SourceLine>Case "B"</SourceLine>
   <SourceLine>P_Class.SelectedRowIndex = 1</SourceLine>
   <SourceLine>Case "C"</SourceLine>
   <SourceLine>P_Class.SelectedRowIndex = 2</SourceLine>
   <SourceLine>End Select</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Channel mask (only for CN470, US915 and AU915)</SourceLine>
   <SourceLine>UI_Mask_Setup</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Not UART_Reconnecting Then</SourceLine>
   <SourceLine>Timer.CallLater(50, AddressOf UI_Busy_Control, False)</SourceLine>
   <SourceLine>UART_User_Port_Selected = False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UI_UpdateActive = False</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>

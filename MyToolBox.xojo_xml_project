 <Method>
  <ItemName>Size</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1041735679</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub Size(assigns s as integer)</SourceLine>
   <SourceLine>mLock.Signal</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'resize and keep old data</SourceLine>
   <SourceLine>Dim TempBuffer As MemoryBlock = Me.Data</SourceLine>
   <SourceLine>Dim TempLength As Integer = TempBuffer.Size</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If s &lt;= 0 Then s = 1</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim OldSize As Integer = Size</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>Size = s</SourceLine>
   <SourceLine>Catch err As OutOfMemoryException</SourceLine>
   <SourceLine>'s exceed the amount available</SourceLine>
   <SourceLine>s = OldSize</SourceLine>
   <SourceLine>Size = OldSize</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>mDataOffset = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If TempLength &lt;= 0 Then</SourceLine>
   <SourceLine>mLock.Release</SourceLine>
   <SourceLine>Return 'there is no old data</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Preserve old data</SourceLine>
   <SourceLine>If s &gt;= OldSize Then</SourceLine>
   <SourceLine>'new size is larger</SourceLine>
   <SourceLine>Me.StringValue(mDataOffset, TempLength) = TempBuffer.StringValue(0, TempLength)</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>'new size is smaller</SourceLine>

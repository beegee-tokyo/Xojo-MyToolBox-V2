 <Method>
  <ItemName>UART_Set_FSK_Param</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>147598335</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function UART_Set_FSK_Param(command As String, value As String, min_val As Double, max_val As Double, hex_value As Boolean) As Boolean</SourceLine>
   <SourceLine>'Send one FSK parameter to the device. Returns True if it was sent.</SourceLine>
   <SourceLine>'Numeric values are checked against the limits of the WisBlockLoRaWAN library,</SourceLine>
   <SourceLine>'the sync word is checked as 1 - 8 bytes (2 - 16 hex digits, even count)</SourceLine>
   <SourceLine>value = value.Trim</SourceLine>
   <SourceLine>If value = "" Then Return False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Var reg As New RegEx</SourceLine>
   <SourceLine>If hex_value Then</SourceLine>
   <SourceLine>reg.SearchPattern = "^([0-9A-Fa-f]{2}){1,8}$"</SourceLine>
   <SourceLine>If reg.Search(value) Is Nil Then</SourceLine>
   <SourceLine>UI_Error_Message("FSK Setting", "Invalid sync word.", "Use 2 - 16 hex digits (1 - 8 bytes), an even number of digits, e.g. C194C1")</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>value = value.Uppercase</SourceLine>
   <SourceLine>Else</SourceLine>
   <SourceLine>reg.SearchPattern = "^[0-9]+$"</SourceLine>
   <SourceLine>If reg.Search(value) Is Nil Then</SourceLine>
   <SourceLine>UI_Error_Message("FSK Setting", "Invalid value.", "Use digits only")</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Var num As Double = Val(value)</SourceLine>
   <SourceLine>If num &lt; min_val Or num &gt; max_val Then</SourceLine>
   <SourceLine>UI_Error_Message("FSK Setting", "Value out of range.", "Allowed range: " + Format(min_val, "0") + " - " + Format(max_val, "0"))</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>'The frequency has two separate ranges, 150 - 960 MHz and 2400 - 2483 MHz (LR2021 only)</SourceLine>
   <SourceLine>If command = "AT+PFREQ=" And num &gt; 960000000 And num &lt; 2400000000 Then</SourceLine>
   <SourceLine>UI_Error_Message("FSK Setting", "Value out of range.", "Allowed range: 150000000 - 960000000 Hz, or 2400000000 - 2483000000 Hz (2.4GHz, LR2021 only)")</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UART_Wait_For = command</SourceLine>
   <SourceLine>UART_AT_Command = UART_Wait_For + value</SourceLine>
   <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
   <SourceLine>UART_AT_TYPE = 0</SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>command As String, value As String, min_val As Double, max_val As Double, hex_value As Boolean</ItemParams>
  <ItemResult>Boolean</ItemResult>
 </Method>

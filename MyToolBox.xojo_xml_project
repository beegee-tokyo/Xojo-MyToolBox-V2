   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub SelectionChanged(item As DesktopMenuItem)</SourceLine>
    <SourceLine>If Not UI_UpdateActive Then</SourceLine>
    <SourceLine>Var nwm As Integer = P_NWM.SelectedRowIndex</SourceLine>
    <SourceLine>if (nwm &lt;&gt; DEV_LoRaMode) Then</SourceLine>
    <SourceLine>DEV_LoRaMode = nwm</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>UART_Wait_For = "AT+NWM="</SourceLine>
    <SourceLine>If DEV_LoRaMode = 0  Then</SourceLine>
    <SourceLine>UART_AT_Command = UART_Wait_For + "0"</SourceLine>
    <SourceLine>UI_Settings.SelectedPanelIndex = 1</SourceLine>
    <SourceLine>ElseIf DEV_LoRaMode = 2 Then</SourceLine>
    <SourceLine>UART_AT_Command = UART_Wait_For + "2"</SourceLine>
    <SourceLine>UI_Settings.SelectedPanelIndex = 2</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>UART_AT_Command = UART_Wait_For + "1"</SourceLine>
    <SourceLine>UI_Settings.SelectedPanelIndex = 0</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>

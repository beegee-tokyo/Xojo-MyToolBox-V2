   <PartID>1469538303</PartID>
   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Action()</SourceLine>
    <SourceLine>Var count As Integer = P_PortList.RowCount</SourceLine>
    <SourceLine>Var port_name As String</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Do not update list after a connection was established</SourceLine>
    <SourceLine>If Not UART_Connected Then</SourceLine>
    <SourceLine>'Check available COM Ports</SourceLine>
    <SourceLine>If SerialDevice.Count &lt;&gt; count Then</SourceLine>
    <SourceLine>'The number of serial devices has changed so update the menu</SourceLine>
    <SourceLine>P_PortList.RemoveAllRows</SourceLine>
    <SourceLine>For i As Integer = 0 To SerialDevice.LastIndex</SourceLine>
    <SourceLine>port_name = SerialDevice.At(i).Name</SourceLine>
    <SourceLine>If port_name.Length &gt; 2 Then</SourceLine>
    <SourceLine>P_PortList.AddRow(SerialDevice.At(i).Name)</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Update list only if no port was selected</SourceLine>
    <SourceLine>If Not UART_Connected And Not UART_User_Port_Selected Then</SourceLine>
    <SourceLine>If SerialDevice.Count &gt; 0 Then</SourceLine>
    <SourceLine>P_PortList.Refresh(True)</SourceLine>
    <SourceLine>Timer.CallLater(50, AddressOf UI_Busy_Control, False)</SourceLine>
    <SourceLine>B_Connect.Enabled = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If Not UART_Connected And UART_Reconnecting And UART_Last_Connection_Port &lt;&gt; "" Then</SourceLine>
    <SourceLine>Ti_PortUpdater.RunMode = Timer.RunModes.Off</SourceLine>
    <SourceLine>Var last_index As Integer = P_PortList.RowCount - 1</SourceLine>
    <SourceLine>For i As Integer = 0 To last_index</SourceLine>
    <SourceLine>Var compare As Integer = UART_Last_Connection_Port.Compare(P_PortList.CellTextAt(i))</SourceLine>
    <SourceLine>If compare = 0 Then</SourceLine>
    <SourceLine>P_PortList.RowSelectedAt(i) = True</SourceLine>
    <SourceLine>UART_Connect</SourceLine>
    <SourceLine>i = SerialDevice.LastIndex + 1</SourceLine>
    <SourceLine>Ti_Reconnect_Timeout.Mode = 0</SourceLine>
    <SourceLine>UART_Reconnecting = False</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>Ti_PortUpdater.RunMode = Timer.RunModes.Multiple 'turn it on</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>End Sub</SourceLine>
   </ItemSource>
  </HookInstance>

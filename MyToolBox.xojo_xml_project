   <ItemSource>
    <TextEncoding>134217984</TextEncoding>
    <SourceLine>Sub Run()</SourceLine>
    <SourceLine>Var retry_send As Integer = 0</SourceLine>
    <SourceLine>Var send_success As Boolean = False</SourceLine>
    <SourceLine>Var stripped_value As String</SourceLine>
    <SourceLine>Var unused As Boolean</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If App.Sem_Uart_Request_Finished.TrySignal Then</SourceLine>
    <SourceLine>System.DebugLog "Sem_Uart_Request_Finished was available"</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>System.DebugLog "Sem_Uart_Request_Finished released"</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If App.Sem_Uart_Command_Finished.TrySignal Then</SourceLine>
    <SourceLine>System.DebugLog "Sem_Uart_Command_Finished was available"</SourceLine>
    <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
    <SourceLine>System.DebugLog "Sem_Uart_Command_Finished released"</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Clear all Semaphores</SourceLine>
    <SourceLine>If App.Sem_Uart_Request_Finished.TrySignal Then</SourceLine>
    <SourceLine>System.DebugLog "Sem_Uart_Request_Finished was available"</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>System.DebugLog "Sem_Uart_Request_Finished released"</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If App.Sem_Uart_Command_Finished.TrySignal Then</SourceLine>
    <SourceLine>System.DebugLog "Sem_Uart_Command_Finished was available"</SourceLine>
    <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
    <SourceLine>System.DebugLog "Sem_Uart_Command_Finished released"</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'1) Wake up the module. The RAK11720 ignores AT commands in power saving mode until it receives a dummy command,</SourceLine>
    <SourceLine>'   other modules just answer OK</SourceLine>
    <SourceLine>UART_WakeDevice</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'2) Get the hardware model</SourceLine>
    <SourceLine>DEV_IsRAK11720 = False</SourceLine>
    <SourceLine>DEV_HWModel = ""</SourceLine>
    <SourceLine>For retry_send = 0 To 2</SourceLine>
    <SourceLine>UART_Timeout_Error = False</SourceLine>
    <SourceLine>unused = App.Sem_Uart_Request_Finished.TrySignal</SourceLine>
    <SourceLine>UART_AT_TYPE = 2</SourceLine>
    <SourceLine>UART_ResponseValue = ""</SourceLine>
    <SourceLine>UART_Wait_For = "AT+HWMODEL="</SourceLine>
    <SourceLine>UART_AT_Command = UART_Wait_For +"?"</SourceLine>
    <SourceLine>' WisBlockLoRaWAN library has a bug for HW model command, it returns only the model number</SourceLine>
    <SourceLine>UART_Wait_For = "rak"</SourceLine>
    <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
    <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Signal</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=0</SourceLine>
    <SourceLine>If UART_Timeout_Error Then</SourceLine>
    <SourceLine>Ti_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>Ti_Handle_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If (UART_Command_Ok) Then</SourceLine>
    <SourceLine>Var hw_model() As String = UART_ResponseValue.Split("=")</SourceLine>
    <SourceLine>' WisBlockLoRaWAN library has a bug for HW model command, it returns only the model number</SourceLine>
    <SourceLine>If (hw_model.Count = 1) Then</SourceLine>
    <SourceLine>DEV_HwModel = "HW model: " + hw_model(0)</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>DEV_HWModel = "HW model: " + hw_model(1)</SourceLine>
    <SourceLine>End IF</SourceLine>
    <SourceLine>retry_send = 5</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If Not UART_Connected Then</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>thread.SleepCurrent (100)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'3) The RAK11720 needs to be woken up before every AT command after it reported SLEEP (done in UART_Send)</SourceLine>
    <SourceLine>DEV_IsRAK11720 = DEV_HWModel.Contains("RAK11720")</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Get network mode</SourceLine>
    <SourceLine>UART_Timeout_Error = False</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Signal</SourceLine>
    <SourceLine>UART_AT_TYPE = 2</SourceLine>
    <SourceLine>UART_ResponseValue = ""</SourceLine>
    <SourceLine>For retry_send = 0 To 2</SourceLine>
    <SourceLine>UART_Wait_For = "AT+NWM="</SourceLine>
    <SourceLine>UART_AT_Command = UART_Wait_For +"?"</SourceLine>
    <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
    <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Signal</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=0</SourceLine>
    <SourceLine>If UART_Timeout_Error Then</SourceLine>
    <SourceLine>Ti_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>Ti_Handle_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If (UART_Command_Ok) Then</SourceLine>
    <SourceLine>Var mode() As String = UART_ResponseValue.Split("=")</SourceLine>
    <SourceLine>If mode(1).Contains("1") Then</SourceLine>
    <SourceLine>'LoRa P2P</SourceLine>
    <SourceLine>DEV_LoraMode = 1</SourceLine>
    <SourceLine>retry_send = 5</SourceLine>
    <SourceLine>send_success = True</SourceLine>
    <SourceLine>ElseIf mode(1).Contains("0") Then</SourceLine>
    <SourceLine>'LoRaWAN</SourceLine>
    <SourceLine>DEV_LoraMode = 0</SourceLine>
    <SourceLine>retry_send = 5</SourceLine>
    <SourceLine>send_success = True</SourceLine>
    <SourceLine>ElseIf mode(1).Contains("2") Then</SourceLine>
    <SourceLine>'FSK</SourceLine>
    <SourceLine>DEV_LoraMode = 2</SourceLine>
    <SourceLine>retry_send = 5</SourceLine>
    <SourceLine>send_success = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If Not UART_Connected Then</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>thread.SleepCurrent (100)</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>Try</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>Catch</SourceLine>
    <SourceLine>End Try</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If Not send_Success Then</SourceLine>
    <SourceLine>Ti_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>Ti_Handle_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>send_success = False</SourceLine>
    <SourceLine>thread.SleepCurrent (100)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Get Send Interval</SourceLine>
    <SourceLine>For retry_send = 0 To 2</SourceLine>
    <SourceLine>UART_Timeout_Error = False</SourceLine>
    <SourceLine>unused = App.Sem_Uart_Request_Finished.TrySignal</SourceLine>
    <SourceLine>UART_AT_TYPE = 2</SourceLine>
    <SourceLine>UART_ResponseValue = ""</SourceLine>
    <SourceLine>UART_Wait_For = "ATC+SendInt="</SourceLine>
    <SourceLine>UART_AT_Command = UART_Wait_For +"?"</SourceLine>
    <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
    <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Signal</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=0</SourceLine>
    <SourceLine>If UART_Timeout_Error Then</SourceLine>
    <SourceLine>Ti_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>Ti_Handle_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If (UART_Command_Ok) Then</SourceLine>
    <SourceLine>Var sendInt() As String = UART_ResponseValue.Split("=")</SourceLine>
    <SourceLine>Dim interval_d As String = sendInt(1)</SourceLine>
    <SourceLine>Dim interval As Integer = Val(interval_d)</SourceLine>
    <SourceLine>DEV_SendInterval = interval</SourceLine>
    <SourceLine>DEV_SendInterval_String = sendInt(1)</SourceLine>
    <SourceLine>retry_send = 5</SourceLine>
    <SourceLine>send_success = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If Not UART_Connected Then</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>thread.SleepCurrent (100)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>If Not send_success Then</SourceLine>
    <SourceLine>DEV_HasSendInt = False</SourceLine>
    <SourceLine>Else</SourceLine>
    <SourceLine>Dev_HasSendInt = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Get RUI3/WisBlock-API version</SourceLine>
    <SourceLine>For retry_send = 0 To 2</SourceLine>
    <SourceLine>UART_Timeout_Error = False</SourceLine>
    <SourceLine>unused = App.Sem_Uart_Request_Finished.TrySignal</SourceLine>
    <SourceLine>UART_AT_TYPE = 2</SourceLine>
    <SourceLine>UART_ResponseValue = ""</SourceLine>
    <SourceLine>UART_Wait_For = "AT+VER="</SourceLine>
    <SourceLine>UART_AT_Command = UART_Wait_For +"?"</SourceLine>
    <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
    <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Signal</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=0</SourceLine>
    <SourceLine>If UART_Timeout_Error Then</SourceLine>
    <SourceLine>Ti_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>Ti_Handle_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If (UART_Command_Ok) Then</SourceLine>
    <SourceLine>Var rui3_ver() As String = UART_ResponseValue.Split("=")</SourceLine>
    <SourceLine>DEV_RUI3Ver = "SDK version: " + rui3_ver(1)</SourceLine>
    <SourceLine>retry_send = 5</SourceLine>
    <SourceLine>send_success = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If Not UART_Connected Then</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>thread.SleepCurrent (100)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Get application version</SourceLine>
    <SourceLine>For retry_send = 0 To 2</SourceLine>
    <SourceLine>UART_Timeout_Error = False</SourceLine>
    <SourceLine>unused = App.Sem_Uart_Request_Finished.TrySignal</SourceLine>
    <SourceLine>UART_AT_TYPE = 2</SourceLine>
    <SourceLine>UART_ResponseValue = ""</SourceLine>
    <SourceLine>UART_Wait_For = "AT+FIRMWAREVER="</SourceLine>
    <SourceLine>UART_AT_Command = UART_Wait_For +"?"</SourceLine>
    <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
    <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Signal</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=0</SourceLine>
    <SourceLine>If UART_Timeout_Error Then</SourceLine>
    <SourceLine>Ti_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>Ti_Handle_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If (UART_Command_Ok) Then</SourceLine>
    <SourceLine>Var app_ver() As String = UART_ResponseValue.Split("=")</SourceLine>
    <SourceLine>DEV_AppVer = "FW version: " + app_ver(1)</SourceLine>
    <SourceLine>retry_send = 5</SourceLine>
    <SourceLine>send_success = True</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If Not UART_Connected Then</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>Next</SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>thread.SleepCurrent (100)</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>'Check LoRa mode</SourceLine>
    <SourceLine>UART_Timeout_Error = False</SourceLine>
    <SourceLine>If DEV_LoRaMode = 1 Then 'LoRaWAN</SourceLine>
    <SourceLine>Var commands() As String = Array("AT+APPKEY=","AT+DEVEUI=","AT+APPEUI=","AT+APPSKEY=","AT+NWKSKEY=","AT+DEVADDR=","AT+DR=","AT+ADR=","AT+BAND=","AT+TXP=","AT+NJM=","AT+Join=","AT+CFM=")</SourceLine>
    <SourceLine>Var idx As Integer</SourceLine>
    <SourceLine>UART_AT_TYPE = 2</SourceLine>
    <SourceLine>for idx = 0 to 12</SourceLine>
    <SourceLine>UART_Timeout_Error = False</SourceLine>
    <SourceLine>UART_ResponseValue = ""</SourceLine>
    <SourceLine>unused = App.Sem_Uart_Request_Finished.TrySignal</SourceLine>
    <SourceLine>UART_Wait_For = commands(idx)</SourceLine>
    <SourceLine>UART_AT_Command = UART_Wait_For +"?"</SourceLine>
    <SourceLine>UI_LogBuffer.Append("&gt; " + UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=1</SourceLine>
    <SourceLine>UART_Send(UART_AT_Command + Chr(13))</SourceLine>
    <SourceLine></SourceLine>
    <SourceLine>App.Sem_Uart_Request_Finished.Signal</SourceLine>
    <SourceLine>Ti_Rx_Timeout.Mode=0</SourceLine>
    <SourceLine>If UART_Timeout_Error Then</SourceLine>
    <SourceLine>Ti_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>Ti_Handle_Comm_Error.Mode = 1</SourceLine>
    <SourceLine>UART_AT_TYPE = 0</SourceLine>
    <SourceLine>Return</SourceLine>
    <SourceLine>End If</SourceLine>
    <SourceLine>If (UART_Command_Ok) Then</SourceLine>
    <SourceLine>Var value() As String = UART_ResponseValue.Split("=")</SourceLine>
    <SourceLine>Select Case idx</SourceLine>

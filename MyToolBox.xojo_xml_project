 <Method>
  <ItemName>UART_Send</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>2086391807</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Sub UART_Send(s As String)</SourceLine>
   <SourceLine>'don't process empty strings</SourceLine>
   <SourceLine>If s = "" Then Return</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'RAK11720: wake up the module if it reported SLEEP</SourceLine>
   <SourceLine>If DEV_IsRAK11720 And UART_DevAsleep And Not UART_WakeInProgress Then UART_WakeDevice</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'empty RX buffer</SourceLine>
   <SourceLine>Var unused As String = S_UART.ReadAll</SourceLine>
   <SourceLine>unused = ""</SourceLine>
   <SourceLine>UART_RxBuffer = ""</SourceLine>
   <SourceLine>UART_RxPending = ""</SourceLine>
   <SourceLine>UART_Command_Ok = False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'add data to the UART_TxBuffer and start the Ti_Transmit</SourceLine>
   <SourceLine>UART_TxBuffer = s + Chr(13)</SourceLine>
   <SourceLine>UART_TX_Bytes_Left = UART_TxBuffer.LenB</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Send the buffer</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Get the data from the UART_TxBuffer. This might throw an OutOfMemoryException if there is too much data</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>Th_Transmit.Data = UART_TxBuffer</SourceLine>
   <SourceLine>Catch e As OutOfMemoryException</SourceLine>
   <SourceLine>'clear the buffers</SourceLine>
   <SourceLine>Th_Transmit.Data = ""</SourceLine>
   <SourceLine>UART_TxBuffer = ""</SourceLine>
   <SourceLine>UART_TX_Bytes_Left = 0</SourceLine>
   <SourceLine>UI_Error_Message("Signal Meter WARNING", "The amount of transmit data is too large for the allocated memory.", "")</SourceLine>
   <SourceLine>Return</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>UART_TxBuffer = ""</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>App.Sem_Tx_Finished.Signal</SourceLine>
   <SourceLine>Th_Transmit.Run</SourceLine>
   <SourceLine>Catch ThreadAlreadyRunningException</SourceLine>
   <SourceLine>UI_Error_Message("Signal Meter WARNING", "Transmission in progress.", "")</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>App.Sem_Uart_Command_Finished.Release</SourceLine>
   <SourceLine>Catch</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>App.Sem_Uart_Request_Finished.Release</SourceLine>
   <SourceLine>Catch</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>App.Sem_Tx_Finished.Release</SourceLine>
   <SourceLine>Catch</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>Return</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>App.Sem_Tx_Finished.Signal</SourceLine>
   <SourceLine>Try</SourceLine>
   <SourceLine>App.Sem_Tx_Finished.Release</SourceLine>
   <SourceLine>Catch</SourceLine>
   <SourceLine>End Try</SourceLine>
   <SourceLine>End Sub</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>s As String</ItemParams>
  <ItemResult></ItemResult>
 </Method>
 <Method>
  <ItemName>UART_SymbolTime</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>1506807807</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function UART_SymbolTime() As Double</SourceLine>
   <SourceLine>'returns how long, in Microseconds, a symbol is</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Calculate the symbol length</SourceLine>
   <SourceLine>Dim NoOfStartBits As Integer = 1</SourceLine>
   <SourceLine>Dim NoOfDataBits As Integer = 8</SourceLine>
   <SourceLine>Dim NoOfStopBits As Integer = 1</SourceLine>
   <SourceLine>Dim NoOfParityBits As Integer = 0</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Dim SymbolLength As Double = NoOfStartBits + NoOfDataBits + NoOfParityBits + NoOfStopBits</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Calculate how long it takes to transmit a symbol</SourceLine>
   <SourceLine>Dim Baud As Integer = 115200</SourceLine>
   <SourceLine>Dim t As Double = SymbolLength * 1000000 / Baud</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Return t</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>

 <Method>
  <ItemName>UART_Transmit</ItemName>
  <Compatibility></Compatibility>
  <Visible>1</Visible>
  <PartID>2126209023</PartID>
  <ItemSource>
   <TextEncoding>134217984</TextEncoding>
   <SourceLine>Function UART_Transmit(Data As String) As Boolean</SourceLine>
   <SourceLine>If S_UART Is Nil Then Return False 'This should never be nil</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Not UART_Connected Then Return False</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Send data to the transmit buffer</SourceLine>
   <SourceLine>If Me.Th_Transmit.Cancel Then Return False</SourceLine>
   <SourceLine>S_UART.Write Data</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'wait until the data is sent</SourceLine>
   <SourceLine>Var start_us As Integer = System.Microseconds</SourceLine>
   <SourceLine>While (System.Microseconds) - start_us &lt; UART_SymbolTime * Data.LenB</SourceLine>
   <SourceLine>WEnd</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>'Wait until there are no more bytes to send</SourceLine>
   <SourceLine>start_us = System.Microseconds</SourceLine>
   <SourceLine>Var t_timeout As Boolean = False</SourceLine>
   <SourceLine>Do</SourceLine>
   <SourceLine>If S_UART Is Nil Then Return False</SourceLine>
   <SourceLine>If Not UART_Connected Then Return False</SourceLine>
   <SourceLine>S_UART.Poll</SourceLine>
   <SourceLine>If (System.Microseconds) - start_us &lt; 5000000 Then</SourceLine>
   <SourceLine>t_timeout = True</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine>Loop Until S_UART.BytesLeftToSend &lt;= 0 Or Th_Transmit.Cancel Or t_timeout</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>If Th_Transmit.Cancel Then</SourceLine>
   <SourceLine>S_UART.reset</SourceLine>
   <SourceLine>Return False</SourceLine>
   <SourceLine>End If</SourceLine>
   <SourceLine></SourceLine>
   <SourceLine>Return True</SourceLine>
   <SourceLine>End Function</SourceLine>
  </ItemSource>
  <TextEncoding>134217984</TextEncoding>
  <AliasName></AliasName>
  <ItemFlags>0</ItemFlags>
  <IsShared>0</IsShared>
  <ItemParams>Data As String</ItemParams>
  <ItemResult>Boolean</ItemResult>
 </Method>
